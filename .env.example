# GEMINI_API_KEY: Required for server-side SettleUp AI Help Assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Cryptographic secret for signing session tokens (defaults safely in dev if unset).
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"

# DB_PATH: Optional custom path for the SQLite database file.
DB_PATH="./settleup.db"

# APP_URL: Public URL where this SettleUp app is hosted (used in email & QR invite links).
APP_URL="MY_APP_URL"

# SMTP Email Configuration (Required for real email invitation delivery)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SettleUp <no-reply@example.com>"

# Optional SMS Configuration via Twilio (Required only for automated server-side SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

