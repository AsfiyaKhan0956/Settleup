# GEMINI_API_KEY: Required for server-side SettleUp AI Help Assistant calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# SESSION_SECRET: Required in production; use a long, random secret (32+ bytes).
SESSION_SECRET="CHANGE_ME_IN_PRODUCTION"

# DB_PATH: Main SQLite database. Created by `npm run db:init` if it does not exist.
# Keep this path stable between runs and back it up regularly.
DB_PATH="./settleup.db"

# Demo sample accounts/data are disabled by default. Set true only if you want demo content.
SEED_DEMO_DATA="false"

# APP_TIME_ZONE: Timezone used for date-only defaults and reporting.
APP_TIME_ZONE="Asia/Kolkata"

# APP_URL: Set this to the public HTTPS origin after free hosting is deployed.
# Example: https://your-settleup-app.example-host.com (no trailing slash).
# Required in production so WhatsApp, QR and email invitations never contain localhost.
APP_URL=""

# SMTP Email Configuration (Required for real email invitation and password-reset delivery)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SettleUp <no-reply@example.com>"

# SMS Configuration via Twilio (Required for automated server-side SMS; not needed for WhatsApp share links)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

